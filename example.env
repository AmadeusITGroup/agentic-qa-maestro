# Example environment variables for QA Maestro MAF
# Copy this file to .env and fill in your values

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4.1
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# JIRA Configuration
JIRA_BASE_URL=https://your-jira-instance.atlassian.net
JIRA_API_TOKEN=your-jira-api-token

# Application Under Test — Credentials (required for E2E pipeline)
APP_USERNAME=your-app-username
APP_PASSWORD=your-app-password

# Optional: SSL Certificate Bundle (for corporate proxies)
# SSL_CERT_FILE=/path/to/combined_ca_bundle.pem
