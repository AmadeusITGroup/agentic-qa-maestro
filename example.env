# Example environment variables for QA Maestro MAF
# Copy this file to .env and fill in your values

# Azure OpenAI Configuration (required)
DEFAULT_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
DEFAULT_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=your-api-key-here

# JIRA Configuration (required)
JIRA_BASE_URL=https://your-jira-instance.atlassian.net
JIRA_API_TOKEN=your-jira-api-token

# Application Under Test — Credentials (required for E2E pipeline)
APP_USERNAME=your-app-username
APP_PASSWORD=your-app-password

# Optional: Azure AD auth for apps behind corporate SSO
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id
# AZURE_SCOPE=api://your-scope/.default

# Optional: SSL Certificate Bundle (for corporate proxies)
# SSL_CERT_FILE=/path/to/combined_ca_bundle.pem
